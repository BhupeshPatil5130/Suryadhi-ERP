# ============================================================
# SEMS — Suryadhi Education Management System
# Backend Environment Configuration Template
# ============================================================

# Server Port & Host Binding (0.0.0.0 required for Docker/Render/Railway)
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# ------------------------------------------------------------
# Database Connections (PostgreSQL / Neon / Supabase / Railway)
# ------------------------------------------------------------
# For Neon PostgreSQL:
# - DATABASE_URL is the pooled connection (contains -pooler.)
# - DIRECT_URL is the direct connection (without -pooler.)
# NOTE: If DIRECT_URL is omitted, SEMS will automatically derive it from DATABASE_URL.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------
# Authentication & JWT Secrets (Must be at least 8 chars, 32+ recommended)
# ------------------------------------------------------------
JWT_SECRET="generate_a_secure_random_jwt_secret_key_minimum_32_chars"
JWT_REFRESH_SECRET="generate_a_secure_random_jwt_refresh_secret_key_32_chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------
# CORS & Cookie Security
# ------------------------------------------------------------
# Allowed origins (comma-separated for multiple origins, or "*" for any origin)
CORS_ORIGIN="https://your-frontend.vercel.app,http://localhost:5173"

# Cookie SameSite policy:
# - Use "lax" if frontend and backend share the same parent domain
# - Use "none" if frontend (e.g. *.vercel.app) and backend (e.g. *.onrender.com) are on different domains
COOKIE_SAME_SITE="lax"

# ------------------------------------------------------------
# Redis Cache & Rate Limiting (OPTIONAL)
# ------------------------------------------------------------
# If left blank or omitted, SEMS automatically falls back to high-performance in-memory cache & rate limiter.
REDIS_URL=""
# REDIS_PASSWORD=""
# REDIS_HOST=""
# REDIS_PORT=6379

# Rate Limiter Window & Request Cap
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------
# Cloudinary / File Uploads (OPTIONAL)
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------------------------
# Error Monitoring (OPTIONAL)
# ------------------------------------------------------------
SENTRY_DSN=""
